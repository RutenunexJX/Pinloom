+void CallAndDelete(std::function<void()>* function) {
+    std::unique_ptr<std::function<void()>> owned(function);
+    (*owned)();
+}
+
+std::wstring Wide(const std::string& text) {
+    int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), (int)text.size(), nullptr, 0);
+    std::wstring result(length, L'\0');
+    if (length) MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), (int)text.size(), result.data(), length);
+    return result;
+}
+std::string Utf8(const std::wstring& text) {
+    int length = WideCharToMultiByte(CP_UTF8, 0, text.data(), (int)text.size(), nullptr, 0, nullptr, nullptr);
+    std::string result(length, '\0');
+    if (length) WideCharToMultiByte(CP_UTF8, 0, text.data(), (int)text.size(), result.data(), length, nullptr, nullptr);
+    return result;
+}
+std::string JsonString(const std::string& value) {
+    std::string result = "\"";
+    for (unsigned char ch : value) {
+        if (ch == '"' || ch == '\\') { result += '\\'; result += ch; }
+        else if (ch < 32) { char escaped[8]; snprintf(escaped, sizeof(escaped), "\\u%04x", ch); result += escaped; }
+        else result += ch;
+    }
+    return result + '"';
+}
+std::wstring WindowText(HWND window) {
+    std::wstring value(GetWindowTextLengthW(window) + 1, L'\0');
+    value.resize(GetWindowTextW(window, value.data(), (int)value.size()));
+    return value;
+}
+std::wstring ExeDirectory() {
+    wchar_t path[32768];
+    DWORD size = GetModuleFileNameW(nullptr, path, dimof(path));
+    std::wstring value(path, size);
+    return value.substr(0, value.find_last_of(L"\\/"));
+}
+std::wstring ProfilePath(const wchar_t* filename) {
+    return Wide(GetAppDataDirTemp()) + L"\\" + filename;
+}
+std::wstring Config(const wchar_t* key) {
+    wchar_t value[32768];
+    auto user = ProfilePath(L"PinloomIntegration.user.ini");
+    GetPrivateProfileStringW(L"Pinloom", key, L"{missing}", value, dimof(value), user.c_str());
+    if (wcscmp(value, L"{missing}") != 0) return value;
+    auto legacy = ExeDirectory() + L"\\PinloomIntegration.ini";
+    GetPrivateProfileStringW(L"Pinloom", key, L"", value, dimof(value), legacy.c_str());
+    return value;
+}
+bool WriteConfig(const wchar_t* key, const std::wstring& value) {
+    auto ini = ProfilePath(L"PinloomIntegration.user.ini");
+    if (GetFileAttributesW(ini.c_str()) == INVALID_FILE_ATTRIBUTES) {
+        HANDLE file = CreateFileW(ini.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file == INVALID_HANDLE_VALUE) return false;
+        const WORD bom = 0xfeff; DWORD written = 0;
+        bool ok = WriteFile(file, &bom, sizeof(bom), &written, nullptr) && written == sizeof(bom);
+        CloseHandle(file);
+        if (!ok) return false;
+    }
+    if (!WritePrivateProfileStringW(L"Pinloom", key, value.c_str(), ini.c_str())) return false;
+    // The cache-flush form returns zero even on success; verify by reading back.
+    WritePrivateProfileStringW(nullptr, nullptr, nullptr, ini.c_str());
+    return Config(key) == value;
+}
+std::vector<std::wstring> CliCandidates() {
+    std::vector<std::wstring> result;
+    auto directory = ExeDirectory();
+    for (const auto& path : {directory + L"\\..\\pinloom_cli.exe", directory + L"\\pinloom_cli.exe", Config(L"CliPath")}) {
+        if (path.empty() || (path.size() < 3) || (path[1] != L':' && path.substr(0, 2) != L"\\\\")) continue;
+        wchar_t absolute[32768];
+        DWORD length = GetFullPathNameW(path.c_str(), dimof(absolute), absolute, nullptr);
+        if (!length || length >= dimof(absolute)) continue;
+        DWORD attributes = GetFileAttributesW(absolute);
+        if (attributes != INVALID_FILE_ATTRIBUTES && !(attributes & FILE_ATTRIBUTE_DIRECTORY)) result.emplace_back(absolute);
+    }
+    return result;
+}
+std::string NewId() {
+    GUID id{}; CoCreateGuid(&id);
+    wchar_t value[40]; StringFromGUID2(id, value, dimof(value));
+    return Utf8(value);
+}
+bool FileStamp(const std::string& path, uint64_t& size, uint64_t& modified) {
+    WIN32_FILE_ATTRIBUTE_DATA data{};
+    if (!GetFileAttributesExW(Wide(path).c_str(), GetFileExInfoStandard, &data)) return false;
+    size = (uint64_t(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+    const uint64_t ticks = (uint64_t(data.ftLastWriteTime.dwHighDateTime) << 32) | data.ftLastWriteTime.dwLowDateTime;
+    modified = (ticks - 116444736000000000ULL) / 10000;
+    return (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0;
+}
+struct Fields : json::ValueVisitor {
+    std::map<std::string, std::string> values;
+    bool Visit(const char* path, const char* value, json::Type) override { values[path] = value; return true; }
+    std::string get(const char* key) const { auto it = values.find(key); return it == values.end() ? "" : it->second; }
+};
+struct CliResult {
+    DWORD exitCode = 5;
+    std::string output, diagnostic;
+    Fields fields;
+    bool parsed = false;
+    bool ok() const { return exitCode == 0 && parsed && fields.get("/ok") == "true"; }
+};
+std::wstring Quote(const std::wstring& arg) {
+    std::wstring out = L"\"";
+    size_t slashes = 0;
+    for (auto ch : arg) {
+        if (ch == L'\\') { ++slashes; continue; }
+        out.append(ch == L'"' ? slashes * 2 + 1 : slashes, L'\\');
+        out += ch; slashes = 0;
+    }
+    out.append(slashes * 2, L'\\');
+    return out + L'"';
+}
+CliResult RunCli(const std::wstring& exe, const std::vector<std::wstring>& args, const std::string& input = "", DWORD timeoutMs = 65000) {
+    CliResult result;
+    SECURITY_ATTRIBUTES security{sizeof(security), nullptr, TRUE};
+    HANDLE outRead=nullptr, outWrite=nullptr, errRead=nullptr, errWrite=nullptr, inRead=nullptr, inWrite=nullptr;
+    auto close = [&] { for (auto h : {outRead,outWrite,errRead,errWrite,inRead,inWrite}) if (h) CloseHandle(h); };
+    if (!CreatePipe(&outRead,&outWrite,&security,0) || !CreatePipe(&errRead,&errWrite,&security,0)
+        || !CreatePipe(&inRead,&inWrite,&security,0)) { close(); result.diagnostic="Cannot create the Pinloom communication pipes"; return result; }
+    SetHandleInformation(outRead,HANDLE_FLAG_INHERIT,0); SetHandleInformation(errRead,HANDLE_FLAG_INHERIT,0);
+    SetHandleInformation(inWrite,HANDLE_FLAG_INHERIT,0);
+    STARTUPINFOW start{}; start.cb=sizeof(start); start.dwFlags=STARTF_USESTDHANDLES|STARTF_USESHOWWINDOW;
+    start.wShowWindow=SW_HIDE; start.hStdInput=inRead; start.hStdOutput=outWrite; start.hStdError=errWrite;
+    PROCESS_INFORMATION process{};
+    auto command = Quote(exe);
+    for (const auto& arg : args) command += L" " + Quote(arg);
+    if (!CreateProcessW(exe.c_str(),command.data(),nullptr,nullptr,TRUE,CREATE_NO_WINDOW,nullptr,nullptr,&start,&process)) {
+        result.diagnostic="Cannot start pinloom_cli.exe. Check Connection settings (Windows " + std::to_string(GetLastError()) + ")";
+        close(); return result;
+    }
+    CloseHandle(outWrite); outWrite=nullptr; CloseHandle(errWrite); errWrite=nullptr;
+    CloseHandle(inRead); inRead=nullptr;
+    DWORD written=0;
+    bool inputOk = input.empty() || (WriteFile(inWrite,input.data(),(DWORD)input.size(),&written,nullptr) && written==input.size());
+    CloseHandle(inWrite); inWrite=nullptr;
+    const auto deadline = GetTickCount64() + timeoutMs;
+    auto drain = [](HANDLE pipe, std::string& target) {
+        DWORD available=0, read=0; char buffer[4096];
+        while (PeekNamedPipe(pipe,nullptr,0,nullptr,&available,nullptr) && available) {
+            if (!ReadFile(pipe,buffer,(DWORD)(std::min)(sizeof(buffer),size_t(available)),&read,nullptr) || !read) break;
+            if (target.size() + read <= 1024 * 1024) target.append(buffer,read);
+        }
+    };
+    while (GetTickCount64() < deadline) {
+        drain(outRead,result.output); drain(errRead,result.diagnostic);
+        if (WaitForSingleObject(process.hProcess,20)==WAIT_OBJECT_0) break;
+    }
+    if (WaitForSingleObject(process.hProcess,0)!=WAIT_OBJECT_0) {
+        // This is only the helper process created above, never the reader or GUI.
+        TerminateProcess(process.hProcess,5);
+        result.diagnostic="The save result is unconfirmed. Retry to query the same request.";
+    } else GetExitCodeProcess(process.hProcess,&result.exitCode);
+    drain(outRead,result.output); drain(errRead,result.diagnostic);
+    CloseHandle(process.hThread); CloseHandle(process.hProcess); close();
+    result.parsed=inputOk && json::Parse(result.output.c_str(),&result.fields);
+    return result;
+}
+std::string RectJson(fz_rect box) {
+    char value[256]; snprintf(value,sizeof(value),"[%.9g,%.9g,%.9g,%.9g]",box.x0,box.y0,box.x1,box.y1);
+    return value;
+}
+}
+
+struct PinloomCaptureState {
+    MainWindow* win=nullptr;
+    WindowTab* tab=nullptr;
+    DocController* controller=nullptr;
+    bool armed=false, busy=false, valid=false, uncertain=false, textAnchor=false;
+    HWND card=nullptr, nameEdit=nullptr, tagsEdit=nullptr, status=nullptr;
+    HFONT font=nullptr;
+    std::wstring name, tags, library, draftDirectory;
+    std::string path, id, locator, submitted;
+    uint64_t size=0, modified=0;
+    int page=0;
+    RectF region{};
+};
+
+namespace {
+PinloomCaptureState* State(MainWindow* win) {
+    if (!win->pinloomCapture) { win->pinloomCapture=new PinloomCaptureState(); win->pinloomCapture->win=win; win->pinloomCapture->draftDirectory=ProfilePath(L"PinloomPendingCaptures"); }
+    return win->pinloomCapture;
+}
+bool CurrentTarget(PinloomCaptureState* s) {
+    if (!s->tab || s->win->CurrentTab()!=s->tab || s->tab->ctrl!=s->controller
+        || !path::IsSame(s->tab->filePath,s->path.c_str())) return false;
+    uint64_t size=0,modified=0;
+    return FileStamp(s->path,size,modified) && size==s->size && modified==s->modified;
+}
+void DraftText(PinloomCaptureState* s) {
+    if (IsWindow(s->nameEdit)) s->name=WindowText(s->nameEdit);
+    if (IsWindow(s->tagsEdit)) s->tags=WindowText(s->tagsEdit);
+}
+void CardStatus(PinloomCaptureState* s, const std::wstring& text) { if (s->card) SetWindowTextW(s->status,text.c_str()); }
+std::wstring DraftPath(PinloomCaptureState* s) { return s->draftDirectory + L"\\" + Wide(s->id) + L".json"; }
+bool PersistDraft(PinloomCaptureState* s) {
+    if (s->id.empty()) return true;
+    DraftText(s);
+    if (!CreateDirectoryW(s->draftDirectory.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) return false;
+    auto content = "{\"protocol\":\"pinloom-pending/v1\",\"id\":" + JsonString(s->id)
+        + ",\"path\":" + JsonString(s->path) + ",\"name\":" + JsonString(Utf8(s->name)) + ",\"tags\":" + JsonString(Utf8(s->tags))
+        + ",\"library\":" + JsonString(Utf8(s->library)) + ",\"locator\":" + JsonString(s->locator) + ",\"submitted\":" + JsonString(s->submitted)
+        + ",\"size\":" + JsonString(std::to_string(s->size)) + ",\"modified\":" + JsonString(std::to_string(s->modified))
+        + ",\"valid\":" + (s->valid ? "true" : "false") + ",\"uncertain\":" + (s->uncertain ? "true" : "false")
+        + ",\"textAnchor\":" + (s->textAnchor ? "true" : "false") + "}";
+    auto file = DraftPath(s), temporary = file + L".tmp";
+    HANDLE handle = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (handle == INVALID_HANDLE_VALUE) return false;
+    DWORD written=0;
+    bool ok = WriteFile(handle, content.data(), (DWORD)content.size(), &written, nullptr) && written == content.size();
+    ok = FlushFileBuffers(handle) && ok;
+    CloseHandle(handle);
+    if (ok) ok = MoveFileExW(temporary.c_str(), file.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != FALSE;
+    if (!ok) DeleteFileW(temporary.c_str());
+    return ok;
+}
+void DraftWriteError(PinloomCaptureState* s) {
+    CardStatus(s, L"Cannot write the recovery draft in the reader profile. Check folder permissions or free space; keep this card open.");
+}
+bool HasFeature(const CliResult& response, const char* feature) {
+    for (const auto& item : response.fields.values)
+        if (item.first.find("/result/captureFeatures[") == 0 && item.second == feature) return true;
+    return false;
+}
+bool Compatible(const CliResult& response, bool textAnchor) {
+    return response.ok() && response.fields.get("/result/captureProtocol") == "pinloom-pdf-capture/v1"
+        && (!textAnchor || HasFeature(response, "text-anchor"));
+}
+std::wstring SaveError(const CliResult& response) {
+    const auto code = response.fields.get("/error/code");
+    if (code == "pending_edits") return L"Pinloom has unsaved edits. Save or discard them in Pinloom, then retry this card.";
+    if (code == "capture_conflict") return L"This request ID already belongs to different content. Query the existing capture before starting another.";
+    if (code == "target_changed") return L"The PDF changed after selection. Reselect the passage; your name and tags are retained.";
+    if (code == "target_unavailable") return L"The original PDF is missing or unreadable. Reopen the file and reselect.";
+    if (code == "duplicate_name" || code == "name_conflict" || code == "duplicate_anchor" || code == "identity_conflict"
+        || (code == "storage_error" && response.fields.get("/error/message").find(" conflicts with ") != std::string::npos))
+        return L"This anchor name conflicts with an existing name or alias. Change the name and retry.";
+    if (code == "storage_error" || code == "operation_failed") return L"Pinloom could not write the library. Check the library and disk permissions, then retry.";
+    if (response.exitCode == 5 || !response.parsed) return L"The save result is unconfirmed. Retry to query the same request in the original library.";
+    auto message = response.fields.get("/error/message");
+    if (!message.empty() && std::all_of(message.begin(), message.end(), [](unsigned char c) { return c < 128; })) return Wide(message);
+    return L"Pinloom rejected this request. Check the name, library and selection, then retry. Error: " + Wide(code);
+}
+void CardControls(PinloomCaptureState* s) {
+    if (!s->card) return;
+    EnableWindow(s->nameEdit,!s->busy && !s->uncertain); EnableWindow(s->tagsEdit,!s->busy && !s->uncertain);
+    EnableWindow(GetDlgItem(s->card,IDOK),!s->busy && (s->valid || s->uncertain));
+    EnableWindow(GetDlgItem(s->card,kReselect),!s->busy && !s->uncertain);
+    EnableWindow(GetDlgItem(s->card,IDCANCEL),!s->busy);
+    EnableWindow(GetDlgItem(s->card,kConnection),!s->busy);
+    SetWindowTextW(GetDlgItem(s->card,IDOK),s->busy ? L"Saving..." : s->uncertain ? L"Retry" : L"Save");
+}
+void HideCard(PinloomCaptureState* s) {
+    DraftText(s);
+    if (s->card) DestroyWindow(s->card);
+    s->card=nullptr;
+    if (s->font) { DeleteObject(s->font); s->font=nullptr; }
+}
+bool Finish(PinloomCaptureState* s, bool saved=false) {
+    const bool focused=s->card && (GetForegroundWindow()==s->card);
+    if (!s->id.empty() && !DeleteFileW(DraftPath(s).c_str())) {
+        const DWORD error=GetLastError();
+        if (error!=ERROR_FILE_NOT_FOUND && error!=ERROR_PATH_NOT_FOUND) {
+            if (saved) s->uncertain=true;
+            CardStatus(s,saved ? L"Saved to Pinloom, but the recovery draft could not be removed. Check profile permissions, then Retry to confirm and clean up."
+                : L"Cannot discard the recovery draft. Check profile permissions and retry Cancel.");
+            CardControls(s); return false;
+        }
+    }
+    HideCard(s); s->id.clear(); s->locator.clear(); s->armed=false; s->valid=false; s->uncertain=false; s->submitted.clear();
+    if (s->win->CurrentTab()==s->tab) { DeleteOldSelectionInfo(s->win,true); ScheduleRepaint(s->win,0); }
+    s->tab=nullptr; s->controller=nullptr;
+    SetToolbarButtonCheckedState(s->win,CmdPinloomCapture,false);
+    if (focused) { SetForegroundWindow(s->win->hwndFrame); SetFocus(s->win->hwndCanvas); }
+    return true;
+}
+void Invalidate(PinloomCaptureState* s) {
+    s->armed=false; s->valid=false;
+    CardStatus(s,L"The document changed or closed. Reselect to continue; your name and tags are retained.");
+    CardControls(s);
+    SetToolbarButtonCheckedState(s->win,CmdPinloomCapture,s->card!=nullptr);
+    if (!PersistDraft(s)) DraftWriteError(s);
+}
+void PlaceCard(PinloomCaptureState* s) {
+    if (!s->card) return;
+    RECT canvas{}; GetClientRect(s->win->hwndCanvas,&canvas);
+    MapWindowPoints(s->win->hwndCanvas,nullptr,(POINT*)&canvas,2);
+    MONITORINFO monitor{sizeof(monitor)}; GetMonitorInfoW(MonitorFromWindow(s->win->hwndFrame,MONITOR_DEFAULTTONEAREST),&monitor);
+    RECT bounds=monitor.rcWork;
+    if (canvas.right-canvas.left>=DpiScale(s->card,380) && canvas.bottom-canvas.top>=DpiScale(s->card,300)) IntersectRect(&bounds,&bounds,&canvas);
+    RECT card{}; GetWindowRect(s->card,&card); int width=card.right-card.left,height=card.bottom-card.top;
+    int x=canvas.left+DpiScale(s->card,12),y=canvas.top+DpiScale(s->card,12);
+    if (s->valid && CurrentTarget(s)) {
+        Rect selected=s->win->AsFixed()->CvtToScreen(s->page,s->region);
+        POINT point{selected.x+selected.dx+DpiScale(s->card,10),selected.y};
+        ClientToScreen(s->win->hwndCanvas,&point); x=point.x; y=point.y;
+        if (x+width>bounds.right) x=canvas.left+selected.x-width-DpiScale(s->card,10);
+    }
+    x=(std::max)(int(bounds.left),(std::min)(x,int(bounds.right)-width));
+    y=(std::max)(int(bounds.top),(std::min)(y,int(bounds.bottom)-height));
+    SetWindowPos(s->card,nullptr,x,y,0,0,SWP_NOSIZE|SWP_NOACTIVATE|SWP_NOZORDER);
+}
+void LayoutCard(PinloomCaptureState* s) {
+    auto scale=[&](int n){return DpiScale(s->card,n);};
+    RECT outer{0,0,scale(360),scale(258)}; AdjustWindowRectEx(&outer,WS_POPUP|WS_CAPTION|WS_SYSMENU,FALSE,WS_EX_TOOLWINDOW|WS_EX_CONTROLPARENT);
+    SetWindowPos(s->card,nullptr,0,0,outer.right-outer.left,outer.bottom-outer.top,SWP_NOMOVE|SWP_NOZORDER|SWP_NOACTIVATE);
+    if (s->font) DeleteObject(s->font);
+    s->font=CreateFontW(-MulDiv(10,DpiGetForHwnd(s->card),72),0,0,0,FW_NORMAL,FALSE,FALSE,FALSE,DEFAULT_CHARSET,OUT_DEFAULT_PRECIS,CLIP_DEFAULT_PRECIS,CLEARTYPE_QUALITY,DEFAULT_PITCH,L"Segoe UI");
+    const int positions[][5]={{1200,12,10,336,34},{1201,12,48,336,20},{1202,12,108,336,20},{1203,12,165,336,40},{IDOK,12,216,86,28},{kReselect,104,216,82,28},{IDCANCEL,192,216,62,28},{kConnection,260,216,88,28},{1204,12,70,336,30},{1205,12,130,336,28}};
+    for (const auto& p:positions) { HWND child=GetDlgItem(s->card,p[0]); MoveWindow(child,scale(p[1]),scale(p[2]),scale(p[3]),scale(p[4]),TRUE); SendMessageW(child,WM_SETFONT,(WPARAM)s->font,TRUE); }
+    PlaceCard(s);
+}
+void ConfigureConnection(PinloomCaptureState* s) {
+    wchar_t file[32768]{};
+    auto candidates=CliCandidates();
+    if (!candidates.empty()) wcsncpy_s(file,candidates.front().c_str(),_TRUNCATE);
+    OPENFILENAMEW dialog{sizeof(dialog)}; dialog.hwndOwner=s->card; dialog.lpstrFile=file; dialog.nMaxFile=dimof(file);
+    dialog.lpstrFilter=L"Pinloom CLI (pinloom_cli.exe)\0pinloom_cli.exe\0"; dialog.lpstrTitle=L"Select Pinloom's pinloom_cli.exe";
+    dialog.Flags=OFN_FILEMUSTEXIST|OFN_PATHMUSTEXIST|OFN_NOCHANGEDIR;
+    if (!GetOpenFileNameW(&dialog)) return;
+    CardStatus(s,L"Checking the selected Pinloom CLI...");
+    auto probe=RunCli(file,{L"session.resolve"},"",5000);
+    if (!Compatible(probe,s->textAnchor)) { CardStatus(s,L"The selected CLI is unavailable or does not support this capture. Select the matching Pinloom package."); return; }
+    if (!WriteConfig(L"CliPath",file)) { CardStatus(s,L"The CLI works, but the binding could not be saved in the reader profile. Check permissions and retry."); return; }
+    if (s->uncertain) { CardStatus(s,L"Binding saved. Retry will query the original target library."); return; }
+    TASKDIALOG_BUTTON choices[]={{IDYES,L"Use Pinloom default"},{IDNO,L"Choose library folder"},{IDCANCEL,L"Keep current library"}};
+    TASKDIALOGCONFIG libraryDialog{};
+    libraryDialog.cbSize=sizeof(libraryDialog); libraryDialog.hwndParent=s->card;
+    libraryDialog.pszWindowTitle=L"Pinloom library"; libraryDialog.pszMainInstruction=L"Choose the target library";
+    libraryDialog.pszContent=L"The CLI binding is saved. Keep the current library or choose a different target.";
+    libraryDialog.dwFlags=TDF_ALLOW_DIALOG_CANCELLATION|TDF_SIZE_TO_CONTENT|TDF_POSITION_RELATIVE_TO_WINDOW;
+    libraryDialog.cButtons=dimof(choices); libraryDialog.pButtons=choices; libraryDialog.nDefaultButton=IDCANCEL;
+    int choose=IDCANCEL;
+    if (FAILED(TaskDialogIndirect(&libraryDialog,&choose,nullptr,nullptr))) {
+        CardStatus(s,L"CLI binding saved. Cannot open library settings; the current library is unchanged."); return;
+    }
+    std::wstring chosen=s->library; bool changed=false;
+    if (choose==IDYES) { chosen.clear(); changed=true; }
+    else if (choose==IDNO) {
+        BROWSEINFOW browse{}; browse.hwndOwner=s->card; browse.lpszTitle=L"Select a Pinloom library folder"; browse.ulFlags=BIF_RETURNONLYFSDIRS|BIF_NEWDIALOGSTYLE;
+        PIDLIST_ABSOLUTE item=SHBrowseForFolderW(&browse);
+        if (item) { wchar_t directory[MAX_PATH]; if (SHGetPathFromIDListW(item,directory)) { chosen=directory; changed=true; } CoTaskMemFree(item); }
+    }
+    if (changed) {
+        if (!WriteConfig(L"LibraryPath",chosen)) { CardStatus(s,L"CLI binding saved, but the library choice could not be saved. The previous library is still selected."); return; }
+        s->library=chosen;
+    }
+    if (!PersistDraft(s)) { DraftWriteError(s); return; }
+    CardStatus(s,s->library.empty()?L"Binding saved. Library: Pinloom default.":L"Binding saved. Library: "+s->library);
+}
+std::string TagsJson(const std::wstring& tags) {
+    std::string result="[";
+    std::wstring token;
+    auto emit=[&] { if (!token.empty()) { if (result.size()>1) result+=','; result+=JsonString(Utf8(token)); token.clear(); } };
+    for (wchar_t ch:tags) { if (ch==L',' || ch==L';' || ch==L'，' || ch==L'；' || ch==L'\n') emit(); else token+=ch; }
+    emit(); return result+"]";
+}
+void StartSave(PinloomCaptureState* s, const std::wstring& cli) {
+    const auto id=s->id, input=s->submitted; const HWND frame=s->win->hwndFrame;
+    const auto library=s->library; const bool wasUncertain=s->uncertain;
+    // The request and target library must be durable before the first possible commit.
+    s->uncertain=true;
+    if (!PersistDraft(s)) { s->uncertain=wasUncertain; s->busy=false; CardControls(s); DraftWriteError(s); return; }
+    CardControls(s);
+    auto work=new std::function<void()>([cli,library,id,input,frame,wasUncertain]() {
+        auto response=std::make_shared<CliResult>();
+        bool alreadySaved=false, attemptedCapture=false;
+        if (wasUncertain) {
+            *response=RunCli(cli,{L"capture.status",L"--library",library,L"--input",L"-",L"--start-gui",L"--timeout",L"20000"},"{\"captureId\":"+JsonString(id)+"}");
+            alreadySaved=response->ok() && response->fields.get("/result/state")=="saved";
+        }
+        if (!alreadySaved && (!wasUncertain || (response->exitCode==3 && response->fields.get("/error/code")=="not_found"))) {
+            attemptedCapture=true;
+            *response=RunCli(cli,{L"capture.pdf",L"--library",library,L"--input",L"-",L"--start-gui",L"--timeout",L"20000"},input);
+        }
+        uitask::Post(MkFunc0(CallAndDelete,new std::function<void()>([frame,id,response,wasUncertain,attemptedCapture]() {
+            auto win=FindMainWindowByHwnd(frame);
+            if (!win || !win->pinloomCapture || win->pinloomCapture->id!=id) return;
+            auto state=win->pinloomCapture; state->busy=false;
+            if (response->ok() && response->fields.get("/result/state")=="saved") {
+                auto message="Saved to Pinloom: "+response->fields.get("/result/name");
+                if (Finish(state,true)) ShowTemporaryNotification(win->hwndCanvas,message.c_str(),4500);
+            } else {
+                state->uncertain=(wasUncertain && !attemptedCapture) || response->exitCode==5 || !response->parsed
+                    || response->fields.get("/error/code")=="capture_conflict";
+                CardStatus(state,SaveError(*response)); CardControls(state);
+                if (!PersistDraft(state)) DraftWriteError(state);
+            }
+        })),"PinloomCaptureResult");
+    });
+    HANDLE worker=StartThread(MkFunc0(CallAndDelete,work),"PinloomCaptureSave");
+    if (worker) CloseHandle(worker);
+    else { delete work; s->busy=false; s->uncertain=wasUncertain; PersistDraft(s); CardControls(s); CardStatus(s,L"Cannot start the save task. Retry this card."); }
+}
+void Submit(PinloomCaptureState* s) {
+    if (s->busy) return;
+    if (!s->uncertain && (!s->valid || !CurrentTarget(s))) { Invalidate(s); return; }
+    DraftText(s);
+    if (s->name.empty()) { CardStatus(s,L"Enter an anchor name."); SetFocus(s->nameEdit); return; }
+    auto candidates=CliCandidates();
+    if (candidates.empty()) { CardStatus(s,L"Pinloom CLI was not found. Use Connection to select pinloom_cli.exe."); return; }
+    if (!s->uncertain) {
+        s->submitted="{\"captureProtocol\":\"pinloom-pdf-capture/v1\",\"captureId\":"+JsonString(s->id)+",\"ifVersion\":\"absent\",\"targetFile\":"+JsonString(s->path)
+            +",\"documentSize\":"+JsonString(std::to_string(s->size))+",\"documentModifiedMs\":"+JsonString(std::to_string(s->modified))
+            +",\"name\":"+JsonString(Utf8(s->name))+",\"tags\":"+TagsJson(s->tags)+",\"locator\":"+s->locator+"}";
+    }
+    if (!PersistDraft(s)) { DraftWriteError(s); return; }
+    const auto id=s->id; const HWND frame=s->win->hwndFrame; const bool textAnchor=s->textAnchor;
+    s->busy=true; CardControls(s); CardStatus(s,L"Connecting to Pinloom...");
+    auto work=new std::function<void()>([candidates,id,frame,textAnchor]() {
+        std::wstring cli, defaultLibrary;
+        for (const auto& candidate : candidates) {
+            auto probe=RunCli(candidate,{L"session.resolve"},"",5000);
+            if (Compatible(probe,textAnchor)) { cli=candidate; defaultLibrary=Wide(probe.fields.get("/result/library")); break; }
+        }
+        uitask::Post(MkFunc0(CallAndDelete,new std::function<void()>([frame,id,cli,defaultLibrary]() {
+            auto win=FindMainWindowByHwnd(frame);
+            if (!win || !win->pinloomCapture || win->pinloomCapture->id!=id) return;
+            auto state=win->pinloomCapture;
+            if (state->library.empty() && !state->uncertain) state->library=defaultLibrary;
+            if (cli.empty() || state->library.empty()) {
+                state->busy=false; CardControls(state);
+                CardStatus(state,L"No compatible Pinloom CLI or target library was found. Check Connection and use the matching Pinloom package."); return;
+            }
+            CardStatus(state,L"Saving to Pinloom..."); StartSave(state,cli);
+        })),"PinloomCaptureConnect");
+    });
+    HANDLE worker=StartThread(MkFunc0(CallAndDelete,work),"PinloomCaptureConnect");
+    if (worker) CloseHandle(worker);
+    else { delete work; s->busy=false; CardControls(s); CardStatus(s,L"Cannot start the connection task. Retry this card."); }
+}
+bool RestoreDraft(MainWindow* win, bool anyFile=false);
+void Arm(MainWindow* win, bool keepDraft) {
+    auto s=State(win);
+    if (!keepDraft && RestoreDraft(win)) return;
+    HideCard(s);
+    if (!keepDraft) { s->name.clear(); s->tags.clear(); s->textAnchor=false; s->library=Config(L"LibraryPath"); s->id=NewId(); }
+    s->tab=win->CurrentTab(); s->controller=s->tab->ctrl; s->path=s->tab->filePath;
+    s->armed=false; s->valid=false; s->uncertain=false; s->submitted.clear(); s->locator.clear();
+    if (!FileStamp(s->path,s->size,s->modified)) { ShowWarningNotification(win->hwndCanvas,"The PDF is unavailable. Reopen the file to continue.",5000); return; }
+    s->armed=true; DeleteOldSelectionInfo(win,true); ScheduleRepaint(win,0);
+    SetToolbarButtonCheckedState(win,CmdPinloomCapture,true);
+    ShowTemporaryNotification(win->hwndCanvas,s->textAnchor ? "Select PDF text. Click Capture again to cancel." : "Drag a PDF rectangle. Click Capture again to cancel.",5000);
+    if (!PersistDraft(s)) ShowWarningNotification(win->hwndCanvas,"Cannot write the recovery draft. Check the reader profile permissions before closing.",6000);
+    SetFocus(win->hwndCanvas); SetCursor(LoadCursorW(nullptr,s->textAnchor ? IDC_IBEAM : IDC_CROSS));
+}
+LRESULT CALLBACK CardProc(HWND window,UINT message,WPARAM wp,LPARAM lp) {
+    auto s=(PinloomCaptureState*)GetWindowLongPtrW(window,GWLP_USERDATA);
+    if (message==WM_NCCREATE) { s=(PinloomCaptureState*)((CREATESTRUCTW*)lp)->lpCreateParams; SetWindowLongPtrW(window,GWLP_USERDATA,(LONG_PTR)s); }
+    if (!s) return DefWindowProcW(window,message,wp,lp);
+    if (message==WM_DESTROY) {
+        DraftText(s);
+        s->card=nullptr; s->nameEdit=nullptr; s->tagsEdit=nullptr; s->status=nullptr;
+        return 0;
+    }
+    if (message==WM_COMMAND && HIWORD(wp)==BN_CLICKED) {
+        switch (LOWORD(wp)) {
+            case IDOK: Submit(s); return 0;
+            case IDCANCEL: SendMessageW(window,WM_CLOSE,0,0); return 0;
+            case kReselect: if (!s->busy && !s->uncertain && PinloomCanCapture(s->win)) Arm(s->win,true); return 0;
+            case kConnection: if (!s->busy) ConfigureConnection(s); return 0;
+        }
+    }
+    if (message==WM_COMMAND && HIWORD(wp)==EN_CHANGE && (LOWORD(wp)==1204 || LOWORD(wp)==1205)
+        && s->nameEdit && s->tagsEdit && s->status && !s->busy && !s->uncertain) {
+        if (!PersistDraft(s)) DraftWriteError(s);
+        return 0;
+    }
+    if (message==WM_CLOSE) {
+        if (s->busy) { CardStatus(s,L"Waiting for the save result. Please wait."); return 0; }
+        if (s->uncertain) {
+            if (!PersistDraft(s)) { DraftWriteError(s); return 0; }
+            HideCard(s); s->armed=false;
+            SetToolbarButtonCheckedState(s->win,CmdPinloomCapture,false);
+            ShowTemporaryNotification(s->win->hwndCanvas,"Unconfirmed request retained. Click Capture to resume and query it.",5500);
+        } else Finish(s);
+        return 0;
+    }
+    if (message==WM_TIMER) {
+        if (!s->busy && s->valid && !CurrentTarget(s)) Invalidate(s);
+        PlaceCard(s); return 0;
+    }
+    if (message==WM_DPICHANGED) { LayoutCard(s); return 0; }
+    if (message==WM_CTLCOLORSTATIC) { SetBkColor((HDC)wp,GetSysColor(COLOR_WINDOW)); return (LRESULT)GetSysColorBrush(COLOR_WINDOW); }
+    return DefWindowProcW(window,message,wp,lp);
+}
+void ShowCard(PinloomCaptureState* s) {
+    static bool registered=false;
+    if (!registered) { WNDCLASSW type{}; type.lpfnWndProc=CardProc; type.hInstance=GetModuleHandleW(nullptr); type.hCursor=LoadCursorW(nullptr,IDC_ARROW); type.hbrBackground=GetSysColorBrush(COLOR_WINDOW); type.lpszClassName=kCardClass; registered=RegisterClassW(&type)!=0; }
+    if (!registered) { ShowWarningNotification(s->win->hwndCanvas,"Cannot create the Pinloom save card.",5000); return; }
+    s->card=CreateWindowExW(WS_EX_TOOLWINDOW|WS_EX_CONTROLPARENT,kCardClass,s->textAnchor ? L"Save Text Anchor to Pinloom" : L"Save Rectangle Anchor to Pinloom",WS_POPUP|WS_CAPTION|WS_SYSMENU,0,0,400,320,s->win->hwndFrame,nullptr,GetModuleHandleW(nullptr),s);
+    if (!s->card) { ShowWarningNotification(s->win->hwndCanvas,"Cannot create the Pinloom save card.",5000); return; }
+    auto control=[&](const wchar_t* cls,const wchar_t* text,int id,DWORD style=0) {
+        return CreateWindowExW(wcscmp(cls,L"EDIT")==0?WS_EX_CLIENTEDGE:0,cls,text,WS_CHILD|WS_VISIBLE|style,0,0,1,1,s->card,(HMENU)(INT_PTR)id,GetModuleHandleW(nullptr),nullptr);
+    };
+    auto filename=s->path.substr(s->path.find_last_of("\\/")+1);
+    auto info=Wide(filename);
+    if (s->page>0) info+=L"  |  Page "+std::to_wstring(s->page);
+    control(L"STATIC",info.c_str(),1200);
+    control(L"STATIC",L"Name",1201); s->nameEdit=control(L"EDIT",s->name.c_str(),1204,WS_TABSTOP|ES_AUTOHSCROLL);
+    SendMessageW(s->nameEdit,EM_SETLIMITTEXT,256,0);
+    control(L"STATIC",L"Tags (optional, comma separated)",1202); s->tagsEdit=control(L"EDIT",s->tags.c_str(),1205,WS_TABSTOP|ES_AUTOHSCROLL);
+    SendMessageW(s->tagsEdit,EM_SETLIMITTEXT,1024,0);
+    s->status=control(L"EDIT",s->library.empty()?L"Library: Pinloom default":(L"Library: "+s->library).c_str(),1203,ES_MULTILINE|ES_READONLY|ES_AUTOVSCROLL|WS_VSCROLL);
+    control(L"BUTTON",L"Save",IDOK,WS_TABSTOP|BS_DEFPUSHBUTTON); control(L"BUTTON",L"Reselect",kReselect,WS_TABSTOP);
+    control(L"BUTTON",L"Cancel",IDCANCEL,WS_TABSTOP); control(L"BUTTON",L"Connection",kConnection,WS_TABSTOP);
+    LayoutCard(s); CardControls(s);
+    if (!PersistDraft(s)) DraftWriteError(s);
+    SetTimer(s->card,1,250,nullptr);
+    ShowWindow(s->card,SW_SHOW); SetForegroundWindow(s->card); SetFocus(s->nameEdit); SendMessageW(s->nameEdit,EM_SETSEL,0,-1);
+    SetToolbarButtonCheckedState(s->win,CmdPinloomCapture,true);
+}
+bool Integer(const Fields& fields, const char* key, int minimum, int maximum, int& result) {
+    auto text=fields.get(key); char* end=nullptr;
+    long long value=strtoll(text.c_str(),&end,10);
+    if (text.empty() || !end || *end || value<minimum || value>maximum) return false;
+    result=(int)value; return true;
+}
+bool ExactText(TextSelection& selection, const Fields& fields) {
+    int startPage=0,endPage=0,startGlyph=0,endGlyph=0;
+    if (!Integer(fields,"/selection/startPage",1,selection.engine->PageCount(),startPage)
+        || !Integer(fields,"/selection/endPage",startPage,(std::min)(startPage+999,selection.engine->PageCount()),endPage)
+        || !Integer(fields,"/selection/startGlyph",0,100000000,startGlyph)
+        || !Integer(fields,"/selection/endGlyph",0,100000000,endGlyph)) return false;
+    int firstLength=0,lastLength=0;
+    selection.textCache->GetTextForPage(startPage,&firstLength);
+    selection.textCache->GetTextForPage(endPage,&lastLength);
+    if (startGlyph>firstLength || endGlyph>lastLength || (startPage==endPage && endGlyph<=startGlyph)) return false;
+    const auto expected=fields.get("/text");
+    if (expected.empty() || expected.size()>65536) return false;
+    selection.StartAt(startPage,startGlyph); selection.SelectUpTo(endPage,endGlyph);
+    if (!selection.result.len) return false;
+    WCHAR* text=selection.ExtractText("\n");
+    const bool same=text && Utf8(text)==expected;
+    str::Free(text); return same;
+}
+bool RestoreDraft(MainWindow* win, bool anyFile) {
+    auto s=State(win); auto tab=win->CurrentTab();
+    if (!tab || !win->AsFixed()) return false;
+    WIN32_FIND_DATAW found{};
+    HANDLE search=FindFirstFileW((s->draftDirectory+L"\\*.json").c_str(),&found);
+    if (search==INVALID_HANDLE_VALUE) return false;
+    bool restored=false;
+    do {
+        if (found.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY || found.nFileSizeHigh || found.nFileSizeLow>2*1024*1024) continue;
+        auto filename=s->draftDirectory+L"\\"+found.cFileName;
+        HANDLE file=CreateFileW(filename.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr);
+        if (file==INVALID_HANDLE_VALUE) continue;
+        std::string content(found.nFileSizeLow,'\0'); DWORD read=0;
+        bool readOk=ReadFile(file,content.data(),(DWORD)content.size(),&read,nullptr) && read==content.size(); CloseHandle(file);
+        Fields draft; GUID id{};
+        if (!readOk || !json::Parse(content.c_str(),&draft) || draft.get("/protocol")!="pinloom-pending/v1"
+            || (!anyFile && !path::IsSame(tab->filePath,draft.get("/path").c_str()))
+            || FAILED(CLSIDFromString(Wide(draft.get("/id")).c_str(),&id))
+            || Wide(draft.get("/id"))+L".json"!=found.cFileName) continue;
+        s->id=draft.get("/id"); s->path=draft.get("/path"); s->name=Wide(draft.get("/name")); s->tags=Wide(draft.get("/tags"));
+        s->library=Wide(draft.get("/library")); s->locator=draft.get("/locator"); s->submitted=draft.get("/submitted");
+        s->textAnchor=draft.get("/textAnchor")=="true"; s->uncertain=draft.get("/uncertain")=="true";
+        s->size=_strtoui64(draft.get("/size").c_str(),nullptr,10); s->modified=_strtoui64(draft.get("/modified").c_str(),nullptr,10);
+        s->tab=tab; s->controller=tab->ctrl; s->armed=false; s->busy=false;
+        Fields locator;
+        const bool parsedLocator=json::Parse(s->locator.c_str(),&locator);
+        s->valid=draft.get("/valid")=="true" && CurrentTarget(s) && parsedLocator;
+        s->page=atoi(locator.get("/page").c_str());
+        double c[4]{}; for (int i=0;i<4;++i) c[i]=atof(locator.get(("/rect["+std::to_string(i)+"]").c_str()).c_str());
+        s->region=RectF(c[0],c[1],c[2]-c[0],c[3]-c[1]);
+        auto dm=win->AsFixed();
+        s->valid=s->valid && dm->ValidPageNo(s->page) && !s->region.IsEmpty();
+        if (s->valid) {
+            if (s->textAnchor) {
+                TextSelection selected(dm->GetEngine(),dm->textSelection->textCache);
+                s->valid=ExactText(selected,locator);
+                if (s->valid) { DeleteOldSelectionInfo(win,true); dm->textSelection->CopySelection(&selected); UpdateTextSelection(win); }
+            } else {
+                DeleteOldSelectionInfo(win,true); tab->selectionOnPage=new Vec<SelectionOnPage>();
+                tab->selectionOnPage->Append(SelectionOnPage(s->page,&s->region)); tab->selectionIsRectangle=true; win->showSelection=true;
+            }
+            if (s->valid) { dm->ScrollTo(s->page,s->region,0); ScheduleRepaint(win,0); }
+        }
+        ShowCard(s);
+        CardStatus(s,s->uncertain ? L"Recovered an unconfirmed request. Retry queries its original library before saving again."
+            : s->valid ? L"Recovered your draft. Review the name and tags, then Save." : L"Recovered your name and tags. Reselect to continue.");
+        restored=true; break;
+    } while (FindNextFileW(search,&found));
+    FindClose(search);
+    return restored || (!anyFile && RestoreDraft(win,true));
+}
+}
+
+bool PinloomCanCapture(MainWindow* win) {
+    auto dm=win?win->AsFixed():nullptr;
+    auto engine=dm?AsEngineMupdf(dm->GetEngine()):nullptr;
+    return engine && engine->pdfdoc && (!win->pinloomCapture || !win->pinloomCapture->busy);
+}
+bool PinloomHasRectangle(MainWindow* win) {
+    if (!PinloomCanCapture(win)) return false;
+    auto tab=win->CurrentTab();
+    return win->showSelection && tab->selectionIsRectangle && tab->selectionOnPage && tab->selectionOnPage->size()==1;
+}
+bool PinloomHasText(MainWindow* win) {
+    if (!PinloomCanCapture(win)) return false;
+    auto tab=win->CurrentTab();
+    return win->showSelection && !tab->selectionIsRectangle && win->AsFixed()->textSelection->result.len>0;
+}
+bool PinloomCaptureSelectsText(MainWindow* win) { return win && win->pinloomCapture && win->pinloomCapture->textAnchor; }
+bool PinloomCaptureIsArmed(MainWindow* win) {
+    auto s=win?win->pinloomCapture:nullptr;
+    if (!s || !s->armed) return false;
+    if (!CurrentTarget(s)) { Invalidate(s); ShowTemporaryNotification(win->hwndCanvas,"The document changed. Your capture draft is retained.",4000); return false; }
+    return true;
+}
+bool PinloomCaptureIsActive(MainWindow* win) { auto s=win?win->pinloomCapture:nullptr; return s && (PinloomCaptureIsArmed(win) || s->card); }
+void PinloomCaptureToggle(MainWindow* win) {
+    if (!PinloomCanCapture(win)) return;
+    auto s=State(win);
+    if (s->card) { SendMessageW(s->card,WM_CLOSE,0,0); return; }
+    if (s->armed) { Finish(s); return; }
+    Arm(win,false);
+}
+void PinloomCaptureFromSelection(MainWindow* win, bool textAnchor) {
+    if (!(textAnchor ? PinloomHasText(win) : PinloomHasRectangle(win))) {
+        ShowWarningNotification(win->hwndCanvas,textAnchor ? "Select text in a PDF with a text layer. Image-only PDFs need an existing OCR text layer." : "Select a rectangle within one PDF page.",6000); return;
+    }
+    auto s=State(win);
+    if (s->card) { SetForegroundWindow(s->card); return; }
+    if (!s->armed) {
+        if (RestoreDraft(win)) return;
+        s->tab=win->CurrentTab(); s->controller=s->tab->ctrl; s->path=s->tab->filePath;
+        s->id=NewId(); s->name.clear(); s->tags.clear(); s->uncertain=false; s->library=Config(L"LibraryPath");
+        if (!FileStamp(s->path,s->size,s->modified)) { ShowWarningNotification(win->hwndCanvas,"The PDF is unavailable. Reopen the document.",5000); return; }
+    }
+    s->textAnchor=textAnchor;
+    std::string selectedText, range;
+    if (textAnchor) {
+        auto text=win->AsFixed()->textSelection;
+        int fromPage=0,fromGlyph=0,toPage=0,toGlyph=0;
+        text->GetGlyphRange(&fromPage,&fromGlyph,&toPage,&toGlyph);
+        if (toPage-fromPage>999) { ShowWarningNotification(win->hwndCanvas,"Select at most 1000 pages. The selection was not saved or truncated.",6000); return; }
+        WCHAR* raw=text->ExtractText("\n"); selectedText=raw ? Utf8(raw) : ""; str::Free(raw);
+        if (selectedText.empty() || selectedText.size()>65536) { ShowWarningNotification(win->hwndCanvas,"Select nonempty text up to 64 KiB UTF-8. The selection was not saved or truncated.",6000); return; }
+        range="{\"startPage\":"+std::to_string(fromPage)+",\"endPage\":"+std::to_string(toPage)
+            +",\"startGlyph\":"+std::to_string(fromGlyph)+",\"endGlyph\":"+std::to_string(toGlyph)+"}";
+    }
+    auto selection=s->tab->selectionOnPage->at(0);
+    if (selection.rect.dx<0.5 || selection.rect.dy<0.5) { ShowWarningNotification(win->hwndCanvas,"The selected region is too small. Reselect to continue.",5000); return; }
+    auto engine=AsEngineMupdf(win->AsFixed()->GetEngine()); auto ctx=engine->Ctx();
+    fz_rect media{},crop{}; int rotation=0; float unit=1;
+    bool geometryOk=true;
+    { ScopedCritSec lock(engine->ctxAccess);
+      fz_try(ctx) {
+        auto page=pdf_lookup_page_obj(ctx,engine->pdfdoc,selection.pageNo-1);
+        media=pdf_to_rect(ctx,pdf_dict_get_inheritable(ctx,page,PDF_NAME(MediaBox)));
+        auto cropObject=pdf_dict_get_inheritable(ctx,page,PDF_NAME(CropBox));
+        crop=cropObject?pdf_to_rect(ctx,cropObject):media; crop=fz_intersect_rect(crop,media);
+        rotation=pdf_to_int(ctx,pdf_dict_get_inheritable(ctx,page,PDF_NAME(Rotate))); rotation=(rotation%360+360)%360;
+        auto userUnit=pdf_dict_get(ctx,page,PDF_NAME(UserUnit)); if (userUnit) unit=pdf_to_real(ctx,userUnit);
+      } fz_catch(ctx) { geometryOk=false; fz_report_error(ctx); }
+    }
+    if (!geometryOk || fz_is_empty_rect(crop) || unit<=0) { ShowWarningNotification(win->hwndCanvas,"Cannot read the PDF page geometry. Reopen the document.",6000); return; }
+    s->region=selection.rect; s->page=selection.pageNo;
+    s->locator=std::string("{\"type\":")+JsonString(textAnchor?"sumatrapdf.text":"sumatrapdf.rect")+",\"version\":3,\"unit\":\"pt\",\"coordinateSpace\":\"page-top-left\",\"page\":"+std::to_string(s->page)
+        +",\"rect\":"+RectJson(ToFzRect(s->region))+",\"mediaBox\":"+RectJson(media)+",\"cropBox\":"+RectJson(crop)
+        +",\"rotation\":"+std::to_string(rotation)+",\"userUnit\":"+std::to_string(unit)+"}";
+    if (textAnchor) { s->locator.pop_back(); s->locator+=",\"selection\":"+range+",\"text\":"+JsonString(selectedText)+"}"; }
+    if (s->name.empty()) s->name=Wide(s->path.substr(s->path.find_last_of("\\/")+1))+L" | Page "+std::to_wstring(s->page);
+    s->armed=false; s->valid=true; ShowCard(s);
+}
+void PinloomCaptureSelectionStopped(MainWindow* win,bool aborted) {
+    if (!PinloomCaptureIsArmed(win)) return;
+    const bool textAnchor=PinloomCaptureSelectsText(win);
+    if (aborted || !(textAnchor ? PinloomHasText(win) : PinloomHasRectangle(win))) {
+        ShowWarningNotification(win->hwndCanvas,textAnchor ? "Select text in a PDF with a selectable text layer. Your draft is retained." : "Select a valid rectangle within one page. Your draft is retained.",6000); return;
+    }
+    PinloomCaptureFromSelection(win,textAnchor);
+}
+void PinloomCaptureDocumentClosed(WindowTab* tab) {
+    auto s=tab->win?tab->win->pinloomCapture:nullptr;
+    if (s && s->tab==tab) {
+        s->tab=nullptr; s->controller=nullptr;
+        if (tab->win->isBeingClosed) PersistDraft(s);
+        else Invalidate(s);
+    }
+}
+bool PinloomCaptureCanClose(MainWindow* win) {
+    auto s=win ? win->pinloomCapture : nullptr;
+    if (!s || s->id.empty() || PersistDraft(s)) return true;
+    TASKDIALOG_BUTTON acknowledge{IDOK,L"OK"};
+    TASKDIALOGCONFIG dialog{}; dialog.cbSize=sizeof(dialog); dialog.hwndParent=s->card ? s->card : win->hwndFrame;
+    dialog.pszWindowTitle=L"Pinloom capture"; dialog.pszMainInstruction=L"Cannot save the recovery draft";
+    dialog.pszContent=L"Check reader profile permissions or cancel the capture before closing.";
+    dialog.dwFlags=TDF_ALLOW_DIALOG_CANCELLATION|TDF_POSITION_RELATIVE_TO_WINDOW;
+    dialog.cButtons=1; dialog.pButtons=&acknowledge; dialog.nDefaultButton=IDOK; dialog.pszMainIcon=TD_ERROR_ICON;
+    TaskDialogIndirect(&dialog,nullptr,nullptr,nullptr);
+    return false;
+}
+void PinloomCaptureDestroy(MainWindow* win) {
+    auto s=win->pinloomCapture;
+    if (s) { PersistDraft(s); HideCard(s); delete s; win->pinloomCapture=nullptr; }
+}
+bool PinloomCaptureDialogMessage(MSG* message) {
+    for (auto win:gWindows) {
+        auto s=win->pinloomCapture;
+        if (s && s->card && (message->hwnd==s->card || IsChild(s->card,message->hwnd))) {
+            if (message->message==WM_KEYDOWN && message->wParam=='A' && (GetKeyState(VK_CONTROL)&0x8000)
+                && (message->hwnd==s->nameEdit || message->hwnd==s->tagsEdit)) {
+                SendMessageW(message->hwnd,EM_SETSEL,0,-1); return true;
+            }
+            return IsDialogMessageW(s->card,message)!=FALSE;
+        }
+    }
+    return false;
+}
+bool PinloomCaptureCopyData(MainWindow* receiving,const COPYDATASTRUCT* data,LRESULT* result) {
+    if (!data || data->dwData!=kBridgeMessage) return false;
+    *result=0;
+    if (!data->lpData || data->cbData<2 || data->cbData>1024*1024) return true;
+    std::string payload((const char*)data->lpData,data->cbData);
+    Fields fields;
+    if (!json::Parse(payload.c_str(),&fields) || fields.get("/protocol")!="pinloom-reader/v1") return true;
+    if (fields.get("/method")=="capabilities") { *result=kBridgeVersion; return true; }
+    if (fields.get("/method")=="text-capabilities") { *result=kTextBridgeVersion; return true; }
+    if (fields.get("/method")=="page-state") {
+        auto path=fields.get("/file");
+        auto dm=receiving?receiving->AsFixed():nullptr;
+        auto tab=receiving?receiving->CurrentTab():nullptr;
+        if (dm && tab && !path.empty() && path::IsSame(tab->filePath,path.c_str()))
+            *result=dm->CurrentPageNo();
+        return true;
+    }
+    const bool textAnchor=fields.get("/method")=="open-text";
+    if (!textAnchor && fields.get("/method")!="open") return true;
+    auto path=fields.get("/file"); char* end=nullptr;
+    uint64_t fileSize=0, fileModified=0;
+    if (!FileStamp(path,fileSize,fileModified)
+        || fields.get("/documentSize")!=std::to_string(fileSize)
+        || fields.get("/documentModifiedMs")!=std::to_string(fileModified)) return true;
+    auto pageText=fields.get("/page");
+    long pageNumber=strtol(pageText.c_str(),&end,10);
+    if (pageText.empty() || !end || *end || pageNumber<1 || pageNumber>1000000) return true;
+    int page=(int)pageNumber;
+    float coordinates[4]{};
+    for (int i=0;i<4;++i) {
+        auto key="/rect["+std::to_string(i)+"]"; auto value=fields.get(key.c_str());
+        double number=strtod(value.c_str(),&end);
+        if (value.empty() || !end || *end || !std::isfinite(number) || std::abs(number)>1e9) return true;
+        coordinates[i]=(float)number;
+    }
+    RectF region(coordinates[0],coordinates[1],coordinates[2]-coordinates[0],coordinates[3]-coordinates[1]);
+    if (path.empty() || page<1 || region.IsEmpty()) return true;
+    auto win=FindMainWindowByFile(path.c_str(),false);
+    if (PinloomCaptureIsActive(win?win:receiving)) { *result=2; return true; }
+    if (win) FindMainWindowByFile(path.c_str(),true);
+    if (!win) { LoadArgs args(path.c_str(),receiving); args.activateExisting=true; args.noPlaceWindow=true; win=LoadDocument(&args); }
+    if (!win || !win->AsFixed() || !win->AsFixed()->ValidPageNo(page) || PinloomCaptureIsActive(win)) return true;
+    auto dm=win->AsFixed(); auto engine=AsEngineMupdf(dm->GetEngine());
+    if (!engine || !engine->pdfdoc || region.Intersect(engine->PageMediabox(page))!=region) return true;
+    if (textAnchor) {
+        TextSelection selected(engine,dm->textSelection->textCache);
+        if (!ExactText(selected,fields) || selected.result.pages[0]!=page || ToRectF(selected.result.rects[0])!=region) return true;
+        DeleteOldSelectionInfo(win,true); dm->textSelection->CopySelection(&selected); UpdateTextSelection(win);
+    } else {
+        DeleteOldSelectionInfo(win,true);
+        auto tab=win->CurrentTab(); tab->selectionOnPage=new Vec<SelectionOnPage>(); tab->selectionOnPage->Append(SelectionOnPage(page,&region));
+        tab->selectionIsRectangle=true; win->showSelection=true;
+    }
+    dm->ScrollTo(page,region,0); ScheduleRepaint(win,0); win->Focus();
+    *result=1;
+    return true;
+}
